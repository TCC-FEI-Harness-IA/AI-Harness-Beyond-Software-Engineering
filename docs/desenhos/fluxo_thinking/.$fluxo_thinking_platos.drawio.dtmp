        <mxCell id="YJjzWlIq-3hENTF15K_v-102" parent="YJjzWlIq-3hENTF15K_v-107" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="Prompt entrada" vertex="1">
