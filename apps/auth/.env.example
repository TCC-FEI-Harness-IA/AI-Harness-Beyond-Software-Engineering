# ─── Serviço de autenticação ─────────────────────────────────────────────────
# development | production. Em produção, cookie Secure, origens https e parâmetros de Argon2
# abaixo do mínimo da OWASP são recusados na inicialização.
APP_ENV=development
LOG_LEVEL=INFO

# MongoDB próprio do serviço (banco separado do backend). Via compose, sobrescrito para mongodb://mongo:27017.
AUTH_MONGODB_URI=mongodb://localhost:27017
AUTH_MONGODB_DATABASE=tcc_auth

# Segredo compartilhado com o backend para a verificação interna de sessões (>= 32 caracteres).
# Prefira AUTH_INTERNAL_TOKEN_FILE apontando para um segredo do Docker (ver scripts/generate-secrets.sh).
# Nunca versione o valor.
AUTH_INTERNAL_TOKEN=
# AUTH_INTERNAL_TOKEN_FILE=/run/secrets/auth_internal_token

# Origens públicas do frontend (CSV). O login/cadastro/logout de outra origem é recusado.
PUBLIC_ORIGINS=http://localhost:5173
# true obrigatório em produção (HTTPS). Em desenvolvimento local sobre http, false.
AUTH_COOKIE_SECURE=false
# Validade absoluta da sessão (24 h; em produção só 86400 é aceito).
AUTH_SESSION_TTL_SECONDS=86400

# Limite de falhas de login por e-mail e por IP na janela (em segundos).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900
# true só atrás do Nginx do projeto, que define X-Real-IP; caso contrário o cliente poderia forjá-lo.
AUTH_TRUST_PROXY_HEADERS=false

AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
# Argon2id (padrão: perfil de baixa memória da RFC 9106: t=3, m=64 MiB, p=4).
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_PARALLELISM=4
