# Carregado automaticamente pelo Vite em modo "test" (vitest). Valores fixos e sem segredo —
# nenhum teste fala com um backend real, então estes valores só precisam satisfazer a
# validação de env.ts para que os módulos de src/api/ possam ser importados nos testes.
# Testes que precisam de um valor diferente usam vi.stubEnv + vi.resetModules (ver
# src/config/env.test.ts).

VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_API_PREFIX=/v1
VITE_REQUEST_TIMEOUT_MS=5000
VITE_WS_OPEN_TIMEOUT_MS=5000

# Provedores oferecidos no seletor. Precisa ser subconjunto de GENAI_AVAILABLE_PROVIDERS
# do backend: open_router | azure_ai_foundry | openai
VITE_AVAILABLE_PROVIDERS=open_router,azure_ai_foundry,openai
# Provedor pre-selecionado. Precisa estar em VITE_AVAILABLE_PROVIDERS.
VITE_DEFAULT_PROVIDER=open_router
VITE_AVAILABLE_MODELS=openai/gpt-4o-mini,openai/gpt-4o
VITE_DEFAULT_MODEL=openai/gpt-4o-mini
VITE_DEFAULT_MAX_TOKENS=1200
VITE_DEFAULT_TEMPERATURE=0.3

VITE_HISTORY_FETCH_CONCURRENCY=6
VITE_HISTORY_SUMMARY_MAX_CHARS=120
VITE_HISTORY_SIDEBAR_SUMMARY_MAX_CHARS=48

VITE_ENABLE_DEBUG_PANEL=false
