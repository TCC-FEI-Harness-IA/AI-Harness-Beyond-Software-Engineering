# ─── Backend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_API_PREFIX=/v1
VITE_REQUEST_TIMEOUT_MS=60000
VITE_WS_OPEN_TIMEOUT_MS=15000

# ─── Modelo ───────────────────────────────────────────────────────────────────
# Provedores oferecidos no seletor. Precisa ser subconjunto de GENAI_AVAILABLE_PROVIDERS
# do backend: open_router | azure_ai_foundry | openai
VITE_AVAILABLE_PROVIDERS=open_router,azure_ai_foundry,openai
# Provedor pre-selecionado. Precisa estar em VITE_AVAILABLE_PROVIDERS.
VITE_DEFAULT_PROVIDER=open_router
# Modelo pre-selecionado enquanto o catalogo (GET /v1/models, colecao `models` do MongoDB)
# nao chega. A lista de escolha vem do catalogo, cadastrado na tela "Modelos".
VITE_DEFAULT_MODEL=deepseek/deepseek-v4-flash-0731
# Limite de tokens POR SESSAO imposto pelo front (entrada + saida, somando todas as chamadas).
# Nunca passa do limite por sessao do backend (LLM_MAX_TOKENS, lido em GET /v1/limits) e precisa
# ser maior que RALPH_FINAL_ANSWER_TOKEN_RESERVE para o Ralph rodar.
VITE_DEFAULT_MAX_TOKENS=50000
VITE_DEFAULT_TEMPERATURE=0.3

# ─── Histórico ────────────────────────────────────────────────────────────────
VITE_HISTORY_FETCH_CONCURRENCY=6
VITE_HISTORY_SUMMARY_MAX_CHARS=120
VITE_HISTORY_SIDEBAR_SUMMARY_MAX_CHARS=48

# ─── Depuração ────────────────────────────────────────────────────────────────
VITE_ENABLE_DEBUG_PANEL=false
