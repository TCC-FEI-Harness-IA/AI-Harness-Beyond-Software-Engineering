# ─── Aplicacao ────────────────────────────────────────────────────────────────
APP_TITLE=TCC API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
# O frontend fala com o backend pela mesma origem (proxy do Vite/Nginx); CORS so importa para
# clientes que chamem o backend diretamente. Credenciais (cookies) nunca sao liberadas por CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ─── Seguranca multiusuario ───────────────────────────────────────────────────
# development | production. Em producao, cookies sem Secure e origens sem https sao recusados.
APP_ENV=development
# Endereco interno do servico de autenticacao (no compose: http://auth:8001).
AUTH_SERVICE_URL=http://localhost:8001
# Segredo compartilhado com o servico de autenticacao (>= 32 caracteres) e chave de aplicacao que
# cifra o cookie da credencial OpenRouter (32 bytes em base64url). Prefira as variantes *_FILE com
# segredos do Docker (scripts/generate-secrets.sh na raiz). Nunca versione os valores.
AUTH_INTERNAL_TOKEN=
# AUTH_INTERNAL_TOKEN_FILE=/run/secrets/auth_internal_token
LLM_CREDENTIAL_ENCRYPTION_KEY=
# LLM_CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/llm_credential_encryption_key
# Origens publicas do frontend (CSV): unicas aceitas em escritas (CSRF) e no handshake dos WebSockets.
PUBLIC_ORIGINS=http://localhost:5173
# true obrigatorio em producao (HTTPS). Mesmo valor de AUTH_COOKIE_SECURE do servico de autenticacao.
COOKIE_SECURE=false
# Endpoint da OpenRouter usado para validar a chave do usuario sem consumir creditos.
OPENROUTER_KEY_VALIDATION_URL=https://openrouter.ai/api/v1/key
# Intervalo de revalidacao da sessao durante uma execucao (logout/expiracao interrompem o trabalho).
AUTH_REVALIDATION_INTERVAL_SECONDS=15
# Limites por conta e por instancia do backend: execucoes simultaneas e inicios por janela.
RUN_MAX_CONCURRENT_PER_USER=2
RUN_MAX_STARTS_PER_WINDOW=30
RUN_STARTS_WINDOW_SECONDS=3600

# ─── LLM: configuracao comum a todos os provedores ────────────────────────────
# Na versao multiusuario so a OpenRouter e oferecida, com a chave de cada usuario (cookie cifrado).
LLM_PROVIDER=open_router
LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Limite de tokens (entrada + saida) POR SESSAO imposto pelo backend, nos dois fluxos e no benchmark.
# O max_tokens pedido pelo front e o limite da sessao e nunca pode passar deste valor (422/1003).
# Cada chamada ao modelo recebe como teto de saida o saldo que resta da sessao.
LLM_MAX_TOKENS=120000
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
# Esforco de raciocinio pedido ao modelo: minimal | low | medium | high (vazio = nao envia).
# O teto de saida de cada chamada cobre raciocinio + resposta; sem limite, um modelo de raciocinio
# gasta o saldo da sessao pensando e devolve conteudo vazio.
LLM_REASONING_EFFORT=minimal

# ─── OpenRouter ───────────────────────────────────────────────────────────────
# Nao existe chave OpenRouter do servidor: cada usuario informa a sua, que fica no navegador num
# cookie cifrado e HttpOnly. OPENROUTER_API_KEY nao e lida pela aplicacao.
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Opcionais: identificam a aplicacao nos rankings da OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# ─── OpenAI / Azure AI Foundry ────────────────────────────────────────────────
# Adapters preservados no codigo, mas nao registrados na versao hospedada: estas credenciais nunca
# sao consumidas por requisicoes de usuarios.
# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
# Opcional: so importa em contas que pertencem a mais de uma organizacao.
OPENAI_ORGANIZATION=

# ─── Azure AI Foundry ─────────────────────────────────────────────────────────
# Origem do recurso, sem barra final. Ex.: https://meu-recurso.services.ai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
# Opcional: so preencha quando o deployment tiver nome diferente do modelo.
AZURE_AI_FOUNDRY_DEPLOYMENT=

# ─── Catalogo GenAI (allowlists) ──────────────────────────────────────────────
# Formatos aceitos: JSON array (["a","b"]) ou CSV (a,b)
# Os modelos cadastrados na colecao MONGODB_MODELS_COLLECTION (tela "Modelos" do front) tambem
# ficam liberados, alem dos listados aqui.
GENAI_AVAILABLE_MODELS=deepseek/deepseek-v4-flash-0731,qwen/qwen3.7-flash,meta-llama/llama-3.1-8b-instruct,qwen/qwen3.6-35b-a3b,meta-llama/llama-3.2-3b-instruct,meta-llama/llama-3.2-1b-instruct,mistralai/ministral-3b-2512,tencent/hy-mt2-30b-a3b,deepseek/deepseek-v4-flash,qwen/qwen3-30b-a3b-instruct-2507,qwen/qwen3.5-flash-02-23,openai/gpt-5-nano
GENAI_AVAILABLE_PROVIDERS=open_router

# ─── Sessao e persistencia ────────────────────────────────────────────────────
# Backend de persistencia de sessoes: json_file | mongodb
RALPH_SESSION_STORAGE_BACKEND=json_file
RALPH_SESSIONS_STORAGE_PATH=./data/sessions
RALPH_SESSION_FLUSH_EVERY_MESSAGE=true
RALPH_SESSION_ID_PREFIX=sess

# MONGODB_URI e MONGODB_DATABASE valem sempre para o catalogo de modelos (MONGODB_MODELS_COLLECTION);
# as colecoes de sessao so importam quando RALPH_SESSION_STORAGE_BACKEND=mongodb.
# Via docker compose, o backend sobrescreve MONGODB_URI para mongodb://mongo:27017
# (nome do servico na rede do compose); fora do docker, aponte para o seu MongoDB local.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tcc
MONGODB_SESSIONS_COLLECTION=sessions
# Catalogo compartilhado de modelos (somente leitura para usuarios; mantido por scripts/seed_models.py)
# e catalogos pessoais (um por conta, indice unico owner_id + model_name).
MONGODB_MODELS_COLLECTION=models
MONGODB_USER_MODELS_COLLECTION=user_models

# ─── Resiliencia de custo ─────────────────────────────────────────────────────
# Atingir qualquer limite interrompe a sessao (status failed, sem resposta final): o harness nunca
# promove resultado reprovado nem sintetiza sem aprovacao global. O limite de tokens da sessao e o
# LLM_MAX_TOKENS (ou o max_tokens pedido, se menor). A reserva de tokens sai desse limite e e uma
# margem de melhor esforco para a sintese, nao uma garantia de conclusao: o limite da sessao precisa
# ser maior que ela.
# Inclui a tentativa inicial: no maximo cinco pares B.1/B.2 por tarefa.
RALPH_MAX_TASK_ATTEMPTS=5
# Planos candidatos do planejamento inicial (A.2 avaliado por A.3), incluindo o primeiro: ate quatro
# revisoes depois de reprovacoes. Independe das tentativas por tarefa, das rodadas de C.2 e das
# correcoes de saida invalida. Esgotado sem aprovacao, a sessao termina sem executar tarefas.
RALPH_MAX_PLANNING_ATTEMPTS=5
RALPH_MAX_ADDITIONAL_PLANNING_ROUNDS=2
RALPH_MAX_TASKS_PER_SESSION=12
RALPH_MAX_LLM_CALLS_PER_SESSION=60
RALPH_FINAL_ANSWER_TOKEN_RESERVE=4000
RALPH_SESSION_TIMEOUT_SECONDS=600

# ─── Fluxo de thinking ────────────────────────────────────────────────────────
RALPH_PROMPT_TEMPLATES_PATH=src/infra/templates
RALPH_JSON_PARSE_MAX_RETRIES=2

# ─── Transporte ───────────────────────────────────────────────────────────────
RALPH_WEBSOCKET_MAX_MESSAGE_BYTES=1048576

# ─── Benchmark ────────────────────────────────────────────────────────────────
# Baterias de benchmark (WS /v1/benchmark/run). Usam o mesmo backend de armazenamento das sessoes.
RALPH_BENCHMARK_SESSIONS_STORAGE_PATH=./data/benchmark-sessions
MONGODB_BENCHMARK_SESSIONS_COLLECTION=benchmark_sessions
# Dataset de questoes (uma pasta por questao: enunciado.md + alternativa_correta.md) e instrucao de resposta
# dos vestibulares. MMLU e GPQA usam as instrucoes em ingles de src/infra/benchmark/prompts/{mmlu,gpqa}.md.
RALPH_BENCHMARK_QUESTIONS_PATH=src/infra/benchmark/questions
RALPH_BENCHMARK_PROMPT_PATH=src/infra/benchmark/prompts/vestibular.md
# Limite superior de questoes executadas em paralelo numa bateria.
RALPH_BENCHMARK_MAX_PARALLEL=10
# Intervalo maximo entre dois frames de progresso (mantem o tempo decorrido atualizado).
RALPH_BENCHMARK_PROGRESS_INTERVAL_SECONDS=1

# ─── Resultados oficiais (publicos) ───────────────────────────────────────────
# Copias preservadas das baterias oficiais (backend json_file) ou colecoes proprias (mongodb).
RALPH_OFFICIAL_STORAGE_PATH=./data/official
MONGODB_OFFICIAL_PUBLICATIONS_COLLECTION=official_publications
MONGODB_OFFICIAL_SESSIONS_COLLECTION=official_sessions
# Datasets cujas sessoes publicas omitem enunciados, prompts e respostas (os autores do GPQA pedem
# que as questoes nao sejam publicadas em texto). Deixe vazio para publicar tudo.
RALPH_PUBLIC_REDACTED_DATASETS=gpqa
