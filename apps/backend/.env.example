# =====================================================================
# TCC Backend - Environment Variables Configuration
# =====================================================================

# Provedor padrão: "azure_foundry" ou "open_router" ou "mock"
DEFAULT_MODEL_PROVIDER=azure_foundry

# ---------------------------------------------------------------------
# Azure AI Foundry Settings
# ---------------------------------------------------------------------
# Endpoint do modelo ou projeto (ex: Serverless / MaaS endpoint)
# Exemplo MaaS: https://<deploy-name>.<region>.models.ai.azure.com/v1/chat/completions
# Exemplo Project: https://<resource>.services.ai.azure.com/models
AZURE_FOUNDRY_ENDPOINT=https://your-deployment.models.ai.azure.com/v1/chat/completions
AZURE_FOUNDRY_API_KEY=your_azure_foundry_api_key_here
AZURE_FOUNDRY_MODEL=meta-llama-3.1-8b-instruct
AZURE_FOUNDRY_API_VERSION=2024-05-01-preview
AZURE_FOUNDRY_MAX_TOKENS=1024
AZURE_FOUNDRY_TEMPERATURE=0.7
AZURE_FOUNDRY_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------
# OpenRouter Settings (Fallback / Alternativo)
# ---------------------------------------------------------------------
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_X_TITLE=TCC-Ralph-Loop
OPENROUTER_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------
# GenAI Catalog Settings
# ---------------------------------------------------------------------
genai_avaliable_models=["meta-llama-3.1-8b-instruct", "meta-llama-3.1-70b-instruct", "meta-llama-3.1-405b-instruct", "openai/gpt-4o-mini", "meta-llama/llama-3.1-8b-instruct"]
genai_avaliable_providers=["azure_foundry", "open_router", "mock"]
