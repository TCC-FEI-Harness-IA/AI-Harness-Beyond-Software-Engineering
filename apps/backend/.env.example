# ─── Aplicacao ────────────────────────────────────────────────────────────────
APP_TITLE=TCC API
APP_VERSION=0.1.0
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── LLM: configuracao comum a todos os provedores ────────────────────────────
# Provedor usado quando a requisicao nao informa um: open_router | azure_ai_foundry | openai
LLM_PROVIDER=open_router
LLM_MODEL=deepseek/deepseek-v4-flash-0731
LLM_MAX_TOKENS=50000
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=30
# Esforco de raciocinio pedido ao modelo: minimal | low | medium | high (vazio = nao envia).
# max_tokens cobre raciocinio + resposta; sem limite, um modelo de raciocinio gasta o
# orcamento inteiro pensando e devolve conteudo vazio.
LLM_REASONING_EFFORT=minimal

# ─── OpenRouter ───────────────────────────────────────────────────────────────
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
# Opcionais: identificam a aplicacao nos rankings da OpenRouter.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_API_KEY=
# Opcional: so importa em contas que pertencem a mais de uma organizacao.
OPENAI_ORGANIZATION=

# ─── Azure AI Foundry ─────────────────────────────────────────────────────────
# Origem do recurso, sem barra final. Ex.: https://meu-recurso.services.ai.azure.com
AZURE_AI_FOUNDRY_ENDPOINT=
AZURE_AI_FOUNDRY_API_KEY=
AZURE_AI_FOUNDRY_API_VERSION=2024-10-21
# Opcional: so preencha quando o deployment tiver nome diferente do modelo.
AZURE_AI_FOUNDRY_DEPLOYMENT=

# ─── Catalogo GenAI (allowlists) ──────────────────────────────────────────────
# Formatos aceitos: JSON array (["a","b"]) ou CSV (a,b)
GENAI_AVAILABLE_MODELS=deepseek/deepseek-v4-flash-0731
GENAI_AVAILABLE_PROVIDERS=open_router,azure_ai_foundry,openai

# ─── Sessao e persistencia ────────────────────────────────────────────────────
# Backend de persistencia de sessoes: json_file | mongodb
RALPH_SESSION_STORAGE_BACKEND=json_file
RALPH_SESSIONS_STORAGE_PATH=./data/sessions
RALPH_SESSION_FLUSH_EVERY_MESSAGE=true
RALPH_SESSION_ID_PREFIX=sess

# So importam quando RALPH_SESSION_STORAGE_BACKEND=mongodb.
# Via docker compose, o backend sobrescreve MONGODB_URI para mongodb://mongo:27017
# (nome do servico na rede do compose); fora do docker, aponte para o seu MongoDB local.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=tcc
MONGODB_SESSIONS_COLLECTION=sessions

# ─── Resiliencia de custo ─────────────────────────────────────────────────────
# Atingir qualquer limite interrompe a sessao (status failed, sem resposta final): o harness nunca
# promove resultado reprovado nem sintetiza sem aprovacao global. A reserva de tokens e uma margem
# de melhor esforco para a sintese, nao uma garantia de conclusao.
RALPH_MAX_TASK_ATTEMPTS=3
RALPH_MAX_ADDITIONAL_PLANNING_ROUNDS=2
RALPH_MAX_TASKS_PER_SESSION=12
RALPH_MAX_LLM_CALLS_PER_SESSION=60
RALPH_SESSION_TOKEN_BUDGET=120000
RALPH_FINAL_ANSWER_TOKEN_RESERVE=4000
RALPH_SESSION_TIMEOUT_SECONDS=600

# ─── Fluxo de thinking ────────────────────────────────────────────────────────
RALPH_PROMPT_TEMPLATES_PATH=src/infra/templates
RALPH_JSON_PARSE_MAX_RETRIES=2

# ─── Transporte ───────────────────────────────────────────────────────────────
RALPH_WEBSOCKET_MAX_MESSAGE_BYTES=1048576

# ─── Benchmark ────────────────────────────────────────────────────────────────
# Baterias de benchmark (WS /v1/benchmark/run). Usam o mesmo backend de armazenamento das sessoes.
RALPH_BENCHMARK_SESSIONS_STORAGE_PATH=./data/benchmark-sessions
MONGODB_BENCHMARK_SESSIONS_COLLECTION=benchmark_sessions
# Dataset de questoes (uma pasta por questao: enunciado.md + alternativa_correta.md) e instrucao de resposta.
RALPH_BENCHMARK_QUESTIONS_PATH=src/infra/benchmark/questions
RALPH_BENCHMARK_PROMPT_PATH=src/infra/benchmark/prompt.md
# Limite superior de questoes executadas em paralelo numa bateria.
RALPH_BENCHMARK_MAX_PARALLEL=10
# Intervalo maximo entre dois frames de progresso (mantem o tempo decorrido atualizado).
RALPH_BENCHMARK_PROGRESS_INTERVAL_SECONDS=1
