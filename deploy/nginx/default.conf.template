# Proxy de produção: frontend, autenticação e API sob a MESMA origem (${PUBLIC_HOST}), por caminhos.
#   /        -> SPA (arquivos estáticos)
#   /auth/   -> serviço de autenticação (só as rotas públicas; /internal nunca é exposto)
#   /v1/     -> backend (HTTP e WebSocket)
# HTTP só redireciona para HTTPS. Os logs não registram cookies, Set-Cookie nem corpos.

log_format ralph '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent $request_time "$http_user_agent"';

# DNS do Docker com validade curta: depois de reiniciar backend ou auth (que podem voltar com outro
# IP), o Nginx resolve o nome de novo em vez de mandar tráfego para o endereço antigo.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map $uri $static_cache_control {
    default "";
    ~^/assets/ "public, max-age=31536000, immutable";
}

server {
    listen 80;
    server_name ${PUBLIC_HOST};
    access_log /var/log/nginx/access.log ralph;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_HOST};
    access_log /var/log/nginx/access.log ralph;
    server_tokens off;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' wss://$host; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header Cache-Control $static_cache_control;

    root /usr/share/nginx/html;
    index index.html;

    # Rotas internas do serviço de autenticação nunca saem pela borda.
    location /internal/ {
        return 404;
    }

    location /auth/ {
        set $auth_upstream http://auth:8001;
        proxy_pass $auth_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 16k;
    }

    location /v1/ {
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Baterias longas por WebSocket: o backend fecha a conexão quando termina.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Importação de bateria (ZIP); o backend também limita o tamanho.
        client_max_body_size 256m;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # SPA: rotas do cliente caem no index.html.
    location / {
        try_files $uri $uri/ /index.html;
        # `expires` preserva a herança dos headers de segurança do servidor.
        expires -1;
    }
}
