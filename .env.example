# Variáveis do Docker Compose (copie para .env na raiz). Não há segredos aqui: eles ficam em ./secrets
# (scripts/generate-secrets.sh) e nunca são versionados.

# Nome de host e origem pública da aplicação em produção (o certificado TLS precisa cobrir o host).
PUBLIC_HOST=localhost
PUBLIC_ORIGIN=https://localhost
# Portas publicadas pelo Nginx (as únicas expostas em produção).
HTTP_PORT=80
HTTPS_PORT=443
